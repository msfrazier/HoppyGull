code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;





// 3D Noise with friendly permission by Inigo Quilez
vec3 hash_noise_range( vec3 p ) {
	p *= mat3(vec3(127.1, 311.7, -53.7), vec3(269.5, 183.3, 77.1), vec3(-301.7, 27.3, 215.3));
	return 2.0 * fract(fract(p)*4375.55) -1.;
}


void fragment() {
// RandomRange:4
	vec3 n_in4p0 = vec3(1.00000, 1.00000, 1.00000);
	float n_in4p1 = 0.00000;
	float n_in4p2 = 1.00000;
	float n_out4p0 = mix(n_in4p1, n_in4p2, hash_noise_range(n_in4p0).x);


// RandomRange:5
	vec3 n_in5p0 = vec3(1.00000, 1.00000, 1.00000);
	float n_in5p1 = 0.00000;
	float n_in5p2 = 1.00000;
	float n_out5p0 = mix(n_in5p1, n_in5p2, hash_noise_range(n_in5p0).x);


// RandomRange:6
	vec3 n_in6p0 = vec3(1.00000, 1.00000, 1.00000);
	float n_in6p1 = 0.00000;
	float n_in6p2 = 1.00000;
	float n_out6p0 = mix(n_in6p1, n_in6p2, hash_noise_range(n_in6p0).x);


// VectorCompose:2
	vec3 n_out2p0 = vec3(n_out4p0, n_out5p0, n_out6p0);


	vec3 n_out3p0;
// ColorFunc:3
	{
		vec3 c = n_out2p0;
		vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
		vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
		n_out3p0 = c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
	}


// Output:0
	ALBEDO = n_out3p0;


}
