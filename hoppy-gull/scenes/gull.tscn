[sub_resource type="GDScript" id="GDScript_wbb4c"]
script/source = "extends CharacterBody3D

const SPEED = 2.0
const fly_dist = 8
#current_pposition is which tile on a plank (0-6) the
#character is on
@onready var current_position : int = 3
@onready var max_height: float = 1
@onready var flying: bool = false
@onready var animation_player = $AnimationPlayer
@onready var dust_clouds = $dust_cloud_gpu_particles
@onready var forward_ray = $forward_ray
@onready var left_ray = $left_ray
@onready var right_ray = $right_ray
@onready var mesh = $\"gull+rig\"

@export var fly_num : int = 3

var final_position : Vector3
var movement_dist : float
var movement_time: float

@onready var state_machine: StateMachine


signal check_position
signal trigger_kill_screen
signal use_fly_skill
signal feather_pickup
signal item_pickup

func _ready() -> void:
	final_position = position
	movement_dist = $Area3D/CollisionShape3D.shape.radius * 2
	state_machine = $\"../state_machine\"
	movement_time = 0.0
	
func _physics_process(delta: float) -> void:

	if (final_position-position).length() >= 1e-2:
		movement_time += delta
		move_and_slide()
	else:
		velocity.x = 0
		velocity.z = 0

	if velocity == Vector3.ZERO and \\
	(state_machine.current_state.name == 'moving' or \\
	state_machine.current_state.name == 'forward'):
		#print(movement_time)
		movement_time = 0.0
		state_machine.set_state(\"alive\")

	pass
		
		
func _process(delta: float) -> void:
	
	if Input.is_action_just_pressed(\"ui_left\") and velocity.is_zero_approx() \\
	and state_machine.current_state.name == \"alive\"\\
	and current_position > 0\\
	and !left_ray.is_colliding():
		animation_player.play(\"hop\")
		mesh.set_rotation(Vector3(
			0,deg_to_rad(90),0
		))
		final_position = (position + Vector3(movement_dist,0,0)).snappedf(0.1)
		var direction := (transform.basis * Vector3(1,0,0)).normalized()
		velocity.x = direction.x * SPEED
		velocity.z = direction.z * SPEED
		current_position -= 1
		check_position.emit(final_position, 0)
		
	elif Input.is_action_just_pressed(\"ui_right\") and velocity.is_zero_approx()\\
	and state_machine.current_state.name == \"alive\"\\
	and current_position < 6\\
	and !right_ray.is_colliding():
		animation_player.play(\"hop\")
		mesh.set_rotation(Vector3(
			0,deg_to_rad(-90),0
		))
		final_position = (position + Vector3(-movement_dist,0,0)).snappedf(0.1)
		var direction := (transform.basis * Vector3(-1,0,0)).normalized()
		velocity.x = direction.x * SPEED
		velocity.z = direction.z * SPEED
		current_position += 1
		check_position.emit(final_position, 0)
		
	elif (Input.is_action_just_pressed(\"ui_up\"))\\
	 and velocity.is_zero_approx()\\
	and state_machine.current_state.name == \"alive\"\\
	and !forward_ray.is_colliding():
		animation_player.play(\"hop\")
		mesh.set_rotation(Vector3(
			0,0,0
		))
		final_position = (position + Vector3(0,0,movement_dist)).snappedf(0.1)
		var direction := (transform.basis * Vector3(0,0,1)).normalized()
		velocity.x = direction.x * SPEED
		velocity.z = direction.z * SPEED
		check_position.emit(final_position, 1)
		
	elif (Input.is_action_just_pressed(\"fly\"))\\
	and velocity.is_zero_approx()\\
	and state_machine.current_state.name == \"alive\"\\
	and self.fly_num > 0:
		mesh.set_rotation(Vector3(
			0,0,0
		))
		final_position = (position + Vector3(0,0,movement_dist*fly_dist)).snappedf(0.1)
		var direction := (transform.basis * Vector3(0,0,1)).normalized()
		velocity.x = direction.x * (SPEED)
		velocity.z = direction.z * (SPEED)
		animation_player.play(\"fly\")
		check_position.emit(final_position, 2)
		fly_num -= 1
		use_fly_skill.emit()
		
func check_if_dead(checking_plank):
	pass


func _on_area_3d_body_entered(body: Node3D) -> void:
	match body.name:
		\"feather\":
			if fly_num < 3:
				fly_num += 1
				feather_pickup.emit()
			else:
				item_pickup.emit(10)
			body.queue_free()
	pass # Replace with function body.


func _on_area_3d_area_entered(area: Area3D) -> void:
	trigger_kill_screen.emit()
	pass # Replace with function body.
	
func _emit_dust_clouds():
	dust_clouds.emitting = true
"

