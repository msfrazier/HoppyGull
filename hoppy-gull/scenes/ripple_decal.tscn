[sub_resource type="GDScript" id="GDScript_fpst3"]
script/source = "extends Decal

signal tween_finished
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	self.rotate_y(randf_range(-2*PI, 2*PI))
	var tween = get_tree().create_tween().set_parallel(true)
	tween.tween_property(
		self,
		\"size\",
		Vector3(3,2,3),
		.5
	)
	tween.tween_property(
		self,
		\"albedo_mix\",
		0.0,
		.5
	)
	
	await tween.finished
	tween_finished.emit()
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass
"

[node name="Decal" type="Decal"]
size = Vector3(0.001, 2, 0.001)
texture_albedo = ExtResource("1_fpst3")
script = SubResource("GDScript_fpst3")
